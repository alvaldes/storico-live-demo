---
/**
 * Safari-style browser frame for embedding the demo in the landing page.
 * Renders the macOS traffic lights, URL bar, and wraps the slot content.
 */
interface Props {
  url?: string;
  height?: string;
}

const { url = 'storico.vercel.app', height = 'auto' } = Astro.props;
---

<div class="safari-frame h-175">
  <!-- Toolbar -->
  <div class="safari-toolbar overflow-hidden">
    <!-- Traffic lights -->
    <div class="traffic-lights">
      <span class="traffic-light red"></span>
      <span class="traffic-light yellow"></span>
      <span class="traffic-light green"></span>
    </div>

    <!-- Navigation buttons -->
    <div class="nav-buttons">
      <button type="button" class="nav-btn" aria-label="Sidebar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
        </svg>
      </button>
      <button type="button" class="nav-btn" aria-label="Back">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      <button type="button" class="nav-btn" aria-label="Forward">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>

    <!-- URL Bar -->
    <div class="url-bar">
      <svg class="lock-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0110 0v4"/>
      </svg>
      <span class="url-text">{url}</span>
      <button type="button" class="refresh-btn" aria-label="Refresh">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M23 4v6h-6"/>
          <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
        </svg>
      </button>
    </div>

    <!-- Right buttons -->
    <div class="right-buttons">
      <button type="button" class="nav-btn" aria-label="Share">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/>
          <polyline points="16 6 12 2 8 6"/>
          <line x1="12" y1="2" x2="12" y2="15"/>
        </svg>
      </button>
      <button type="button" class="nav-btn" aria-label="New Tab">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </button>
      <button type="button" class="nav-btn" aria-label="Tabs">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Content area -->
  <div class="safari-content" style={height !== 'auto' ? `height: ${height}` : undefined}>
    <slot />
  </div>
</div>

<style>
  .safari-frame {
    --toolbar-height: 52px;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.1);
    background: #f5f5f5;
  }

  :global([data-theme='dark']) .safari-frame {
    background: #1a1a1a;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .safari-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px 0 12px;
    height: var(--toolbar-height);
    background: linear-gradient(180deg, #f8f8f8 0%, #e8e8e8 100%);
    border-bottom: 1px solid #d0d0d0;
  }

  :global([data-theme='dark']) .safari-toolbar {
    background: linear-gradient(180deg, #2d2d2d 0%, #1f1f1f 100%);
    border-bottom: 1px solid #3a3a3a;
  }

  .traffic-lights {
    display: flex;
    gap: 8px;
    padding-right: 4px;
    flex-shrink: 0;
  }

  .traffic-light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .traffic-light.red {
    background: #ff5f57;
    border: 1px solid #e0443e;
  }

  .traffic-light.yellow {
    background: #febc2e;
    border: 1px solid #dea123;
  }

  .traffic-light.green {
    background: #28c840;
    border: 1px solid #1aab29;
  }

  .nav-buttons {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #666;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  :global([data-theme='dark']) .nav-btn {
    color: #999;
  }

  .nav-btn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #333;
  }

  :global([data-theme='dark']) .nav-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .url-bar {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #fff;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    font-size: 13px;
    color: #333;
  }

  :global([data-theme='dark']) .url-bar {
    background: #2a2a2a;
    border-color: #444;
    color: #e0e0e0;
  }

  .lock-icon {
    color: #888;
  }

  :global([data-theme='dark']) .lock-icon {
    color: #666;
  }

  .url-text {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
    font-weight: 400;
  }

  .refresh-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #888;
    cursor: pointer;
  }

  .refresh-btn:hover {
    color: #333;
  }

  :global([data-theme='dark']) .refresh-btn {
    color: #666;
  }

  :global([data-theme='dark']) .refresh-btn:hover {
    color: #fff;
  }

  .right-buttons {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .safari-content {
    background: #fff;
    flex: 1;
    min-height: 0;
    overflow: visible;
  }

  :global([data-theme='dark']) .safari-content {
    background: #0f141d;
  }
</style>
