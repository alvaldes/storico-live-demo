---
/**
 * Document shell: the product's dashboard frame, reproduced.
 *
 * `SidebarProvider` in the product is a flex row that declares the two sidebar
 * widths as CSS variables; that is the whole of it here. Then `AppSidebar`, and
 * the inset column with the header on top and the page content below, in the
 * product's padding (`p-4 lg:p-6`).
 *
 * The demo's own framing lives inside the content area, as a page header, which
 * is an idiom the product's pages already use. The honesty line at the bottom is
 * the one element the product has no equivalent for.
 */
import AppHeader from '@/components/AppHeader.astro';
import AppSidebar from '@/components/AppSidebar.astro';
import DemoUpgradeModal from '@/components/DemoUpgradeModal.astro';
import SafariFrame from '@/components/SafariFrame.astro';
import { getT, type Locale } from '@/i18n';
import '@/styles/globals.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.demo.title}</title>
    <meta name="description" content={t.demo.subtitle} />
    <link rel="icon" href="data:," />

    <!--
      Anti-flash. Same contract as the product: localStorage['theme'] holds
      'light' | 'dark' | 'system' and the resolved value lives on
      <html data-theme>. Sharing the key means a preference set on the product's
      landing carries over to this page and back.
    -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || 'system';
        if (theme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body class="bg-(--color-surface) p-4 lg:p-8">
    <SafariFrame url="storico.vercel.app/demo" height="70vh">
      <div
        class="group/sidebar-wrapper flex h-full w-full overflow-hidden"
        style="--sidebar-width: 16rem; --sidebar-width-icon: 3rem;"
      >
        <AppSidebar locale={locale} />

        <div class="relative flex w-full flex-1 flex-col bg-background overflow-hidden">
          <AppHeader locale={locale} />

          <main class="flex min-w-0 flex-1 flex-col p-4 lg:p-6 overflow-x-hidden overflow-y-auto">
            <!--
              The demo's own framing, on the entry view only: from the board on,
              the product's page titles speak for themselves, and stacking two
              headings would read as a page title above a page title.
            -->
            <div data-view-when="stories" class="mb-6">
              <h1 class="text-2xl font-bold tracking-tight text-foreground">
                {t.demo.title}
              </h1>
              <p class="mt-1 text-sm text-muted-foreground">{t.demo.subtitle}</p>
            </div>

            <div class="min-h-0 flex-1">
              <slot />
              <div class="mt-6 border-t border-(--color-border) py-4 text-xs text-(--color-text-secondary)">
                <p class="m-0">{t.demo.footerNote}</p>
              </div>
            </div>
          </main>
        </div>
      </div>
    </SafariFrame>

    <DemoUpgradeModal locale={locale} />

    <script>
      import '@/scripts/demo';
    </script>
  </body>
</html>
